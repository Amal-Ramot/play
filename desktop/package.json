{
  "name": "migrash-hamischakim",
  "productName": "מגרש המשחקים",
  "version": "1.0.0",
  "description": "מגרש המשחקים – גרסת מחשב עם גרפיקה מקסימלית",
  "main": "main.js",
  "author": "amal-ramot",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --publish never"
  },
  "devDependencies": {
    "electron": "38.2.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "io.github.amal-ramot.play",
    "productName": "מגרש המשחקים",
    "artifactName": "migrash-${version}-${arch}-${target}.${ext}",
    "files": ["main.js", "preload.js", "game/**/*"],
    "win": { "icon": "icon.png" },
    "nsis": { "oneClick": true, "perMachine": false, "shortcutName": "מגרש המשחקים", "createDesktopShortcut": true },
    "portable": { "artifactName": "migrash-portable.exe" }
  }
}
